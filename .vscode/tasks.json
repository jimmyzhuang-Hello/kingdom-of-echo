{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build raylib game",
            "type": "shell",
            "command": "gcc",
            "args": [
                "src/*.c",
                "-o", "game.exe",
                "-I", "include",
                "-L", "lib",
                "-lraylib",
                "-lopengl32",
                "-lgdi32",
                "-lwinmm"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
